% =====================================================================
%  enerphyadvert.sty  —  Enerphy course ADVERT / marketing one-pager.
%
%  A separate layout from the certificate engine. Renders a fancy A4
%  poster: hero banner (image or gradient) with the title over it, an
%  intro, a "what's in it for you" list, a programme-details card and a
%  call to action. Content comes from an advert file in adverts/<key>/.
%
%     \makeadvert           render the poster from the \adv* macros
%     (see adverts/iso-14064-ghg/advert.tex for the fields)
%
%  Pure LaTeX — works locally and on Overleaf. Reuses src/company.tex.
% =====================================================================
\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{enerphyadvert}[2026/07/07 v1.0 Enerphy advert engine]

\RequirePackage[a4paper,margin=0pt]{geometry}
\RequirePackage{tikz}
\RequirePackage[T1]{fontenc}
\RequirePackage{helvet}
\renewcommand{\familydefault}{\sfdefault}
\RequirePackage{microtype}
\RequirePackage{graphicx}
\RequirePackage{etoolbox}
\RequirePackage{qrcode}                 % real, scannable registration QR
\usetikzlibrary{calc,fadings}
\pagestyle{empty}

% ---- palette (climate greens + the Enerphy accent) -----------------
\definecolor{adInk}{RGB}{18,46,38}          % deep green (hero bottom / card)
\definecolor{adGreen}{RGB}{28,110,90}
\definecolor{adTeal}{RGB}{45,150,128}       % hero top
\definecolor{adBody}{RGB}{55,62,66}         % body text
\definecolor{adSoft}{RGB}{110,120,120}      % secondary text
\definecolor{adLight}{RGB}{238,244,241}     % light panel
\definecolor{adAccent}{RGB}{228,118,32}     % orange accent

% ---- content fields (defaults; overridden by adverts/<key>/advert.tex)
\providecommand{\advKicker}{PROFESSIONAL TRAINING}
\providecommand{\advTitle}{Course Title}
\providecommand{\advSubtitle}{Subtitle}
\providecommand{\advIntro}{Intro paragraph.}
\providecommand{\advBenefitsHead}{What's in it for you?}
\providecommand{\advBenefitsA}{}
\providecommand{\advBenefitsB}{}
\providecommand{\advDates}{--}
\providecommand{\advTime}{--}
\providecommand{\advLocation}{--}
\providecommand{\advFormat}{--}
\providecommand{\advCTA}{Seats are limited.}
\providecommand{\advAudienceHead}{Who should attend?}
\providecommand{\advAudience}{}
\providecommand{\advHeroImage}{}            % empty = drawn gradient hero
\providecommand{\advRegisterURL}{https://enerphy-suisse.ch/}   % encoded in the QR
\providecommand{\advRegisterShow}{\advRegisterURL}             % shown as text
\providecommand{\advHeroTag}{Measure. Reduce. Report.}        % heading line in the hero glass card

% small inline check mark used for benefit bullets
\newcommand{\leafmark}{\tikz[baseline=-0.5ex]{\draw[adAccent,line width=1.1pt,line cap=round]
  (0,0) -- (0.09,-0.09) -- (0.26,0.13);}}
% a check-marked benefit line (hanging indent)
\newcommand{\abullet}{\par\vspace{4pt}\noindent
  \hangindent=0.5cm\hangafter=1 \leafmark\hspace{0.24cm}}

% simple TikZ icons for the details card (drawn in the current colour,
% top-left at the origin, ~0.44cm box, growing downward)
\newcommand{\icoCal}{%
  \draw[line width=1pt,rounded corners=1.5pt] (0,-0.06) rectangle (0.42,-0.4);
  \fill (0,-0.06) rectangle (0.42,-0.16);
  \draw[line width=1pt] (0.1,0)--(0.1,-0.1) (0.32,0)--(0.32,-0.1);}
\newcommand{\icoClock}{%
  \draw[line width=1pt] (0.21,-0.23) circle (0.19);
  \draw[line width=1pt] (0.21,-0.23)--(0.21,-0.11) (0.21,-0.23)--(0.31,-0.27);}
\newcommand{\icoPin}{%
  \fill (0.2,-0.42) .. controls (0.0,-0.18) and (0.02,-0.02) .. (0.2,-0.02)
        .. controls (0.38,-0.02) and (0.4,-0.18) .. (0.2,-0.42) -- cycle;
  \fill[white] (0.2,-0.17) circle (0.055);}
\newcommand{\icoScreen}{%
  \draw[line width=1pt,rounded corners=1.5pt] (0,-0.05) rectangle (0.44,-0.34);
  \draw[line width=1pt] (0.15,-0.34)--(0.13,-0.42) (0.29,-0.34)--(0.31,-0.42) (0.1,-0.42)--(0.34,-0.42);}

% one item in the programme-details card: {coord}{icon}{label}{value}
% (coord is a bare calc expression, WITHOUT surrounding $...$)
\newcommand{\dblk}[4]{%
  \begin{scope}[shift={($#1$)},adAccent,line cap=round]#2\end{scope}
  \node[anchor=north west, inner sep=0, text=white!60, font=\scriptsize\bfseries] at ($#1+(0.66,-0.02)$) {#3};
  \node[anchor=north west, inner sep=0, text=white, font=\small, text width=5.6cm] at ($#1+(0.66,-0.36)$) {#4};
}

% ---- the top banner (photo if \advHeroImage is set, else gradient) ---
% The title sits BELOW this banner, so the photo is shown full and centred
% on its subject (width = page, cropped to the band height by the clip).
\newcommand{\adverthero}[1]{% #1 = banner height in cm
  \begin{scope}
    \clip (current page.north west) rectangle ($(current page.north east)+(0,-#1)$);
    \ifdefempty{\advHeroImage}{%
      \shade[top color=adTeal, bottom color=adInk]
        (current page.north west) rectangle ($(current page.north east)+(0,-#1)$);
      \begin{scope}[shift={($(current page.north east)+(-3.4,-#1)$)}]
        \foreach \r in {1.2,1.9,...,4.4}{\draw[white,opacity=0.08,line width=0.4pt] (0,3) circle (\r);}
      \end{scope}
    }{%
      \node[anchor=center, inner sep=0] at ($(current page.north)+(0,{-#1/2})$)
        {\includegraphics[width=\paperwidth]{\advHeroImage}};
    }%
    % subtle dark scrim at the very top so the white logo stays legible
    \fill[adInk,opacity=0.42,path fading=south]
      (current page.north west) rectangle ($(current page.north east)+(0,-2.3)$);
  \end{scope}
  % crisp accent divider under the banner
  \fill[adAccent] ($(current page.north west)+(0,-#1)$) rectangle ($(current page.north east)+(0,{-#1-0.11})$);
}

% =====================================================================
\newcommand{\makeadvert}{%
\begin{tikzpicture}[remember picture,overlay]
  \fill[white] (current page.south west) rectangle (current page.north east);

  % ---- subtle contour background (drawn FIRST, so it sits behind the
  %      hero image/gradient up top and behind the body text below) ----
  \begin{scope}
    \clip (current page.south west) rectangle (current page.north east);
    \begin{scope}[shift={($(current page.center)+(4.2,-4.5)$)}]
      % wider-spaced, more visible topographic rings
      \foreach \r [count=\i] in {1.6,3.0,...,22}{
        \pgfmathsetmacro\op{0.22-0.006*\r}
        \pgfmathtruncatemacro\sel{mod(\i,2)}
        \edef\rc{\ifcase\sel adTeal\or adGreen\fi}%
        \draw[\rc,line width=0.55pt,opacity=\op]
          plot[domain=0:360,samples=340,smooth cycle,variable=\a]
          ({(\r+0.7*sin(3*\a+\r*20))*cos(\a)},{(\r+0.7*sin(3*\a+\r*20))*sin(\a)});
      }
    \end{scope}
  \end{scope}

  \adverthero{9.6}   % photo/gradient banner — covers the pattern up top

  % ---- frosted "glass" brand card over the banner (top-left) --------
  %  A translucent dark-glass panel (glassmorphism). LaTeX has no live
  %  blur, so the photo shows through darkened rather than frosted; the
  %  tint + light border + rounded corners still read as glass.
  %  (vertically centred on the left of the 9.6cm banner)
  \begin{scope}
    % card body (dark tint) + faint milky frost layer
    \fill[adInk,opacity=0.42,rounded corners=9pt]
      ($(current page.north west)+(1.15,-3.65)$) rectangle ($(current page.north west)+(8.8,-5.95)$);
    \fill[white,opacity=0.05,rounded corners=9pt]
      ($(current page.north west)+(1.15,-3.65)$) rectangle ($(current page.north west)+(8.8,-5.95)$);
    % thin glass border
    \draw[white,opacity=0.34,line width=0.6pt,rounded corners=9pt]
      ($(current page.north west)+(1.15,-3.65)$) rectangle ($(current page.north west)+(8.8,-5.95)$);
    % company name
    \node[anchor=north west, text=white, font=\Large\bfseries, inner sep=0] at
      ($(current page.north west)+(1.62,-4.18)$) {\companyName};
    % heading / tagline line
    \node[anchor=north west, text=white, font=\footnotesize, inner sep=0] at
      ($(current page.north west)+(1.62,-5.12)$) {\advHeroTag};
  \end{scope}

  % ---- title block (BELOW the banner) -------------------------------
  \node[anchor=north west, text=adAccent, font=\bfseries\footnotesize] at
       ($(current page.north west)+(1.35,-10.35)$) {\advKicker};
  \node[anchor=north west, text=adInk, text width=18.5cm, font=\fontsize{26}{29}\selectfont\bfseries]
       at ($(current page.north west)+(1.3,-10.8)$)
       {\hyphenchar\font=-1 \advTitle};
  \node[anchor=north west, text=adGreen, text width=18cm, font=\normalsize] at
       ($(current page.north west)+(1.35,-13.05)$) {\advSubtitle};

  % ---- intro --------------------------------------------------------
  \node[anchor=north west, text=adBody, text width=18.4cm, align=justify, font=\small] at
       ($(current page.north west)+(1.3,-14.2)$) {\advIntro};

  % ---- benefits (LEFT column, ~60%) ---------------------------------
  \node[anchor=north west, text=adInk, font=\large\bfseries] at
       ($(current page.north west)+(1.3,-17.5)$) {\advBenefitsHead};
  \draw[adAccent,line width=1.4pt]
       ($(current page.north west)+(1.35,-18.05)$) -- ($(current page.north west)+(3.9,-18.05)$);
  \node[anchor=north west, text=adBody, text width=10.3cm, font=\small] at
       ($(current page.north west)+(1.3,-18.45)$) {\advBenefitsA\advBenefitsB};

  % ---- programme details card (RIGHT; tightened to end near benefits) -
  % card bleeds to the right page edge (zero right margin); left corners
  % rounded, right corners square for a clean bleed
  \fill[adInk]
       ($(current page.north east)+(0,-17.3)$) -- ($(current page.north east)+(0,-23.9)$)
       [rounded corners=6pt]
       -- ($(current page.north west)+(12.4,-23.9)$) -- ($(current page.north west)+(12.4,-17.3)$)
       [sharp corners] -- cycle;
  \node[anchor=north west, text=adAccent, font=\bfseries\small] at
       ($(current page.north west)+(12.9,-17.75)$) {PROGRAMME DETAILS};
  \dblk{(current page.north west)+(12.9,-18.6)}{\icoCal}{DATES}{\advDates}
  \dblk{(current page.north west)+(12.9,-19.85)}{\icoClock}{TIME}{\advTime}
  \dblk{(current page.north west)+(12.9,-21.1)}{\icoPin}{LOCATION}{\advLocation}
  \dblk{(current page.north west)+(12.9,-22.35)}{\icoScreen}{FORMAT}{\advFormat}

  % ---- who should attend (full width, moved up) --------------------
  \node[anchor=north west, text=adInk, font=\large\bfseries] at
       ($(current page.north west)+(1.3,-24.4)$) {\advAudienceHead};
  \draw[adAccent,line width=1.4pt]
       ($(current page.north west)+(1.35,-24.95)$) -- ($(current page.north west)+(3.9,-24.95)$);
  \node[anchor=north west, text=adBody, text width=18.4cm, align=left, font=\small] at
       ($(current page.north west)+(1.3,-25.35)$) {\advAudience};

  % ---- registration box (full-width, light outlined) ---------------
  \draw[adGreen, line width=0.8pt, rounded corners=5pt, fill=adLight]
       ($(current page.north west)+(1.3,-26.6)$) rectangle ($(current page.north east)+(-1.3,-28.6)$);
  \node[anchor=east, inner sep=0] at ($(current page.north east)+(-1.75,-27.6)$)
       {\qrcode[height=1.65cm,level=M]{\advRegisterURL}};
  \node[anchor=west, text width=13.6cm, text=adInk, font=\small] at
       ($(current page.north west)+(1.85,-27.6)$)
       {\itshape\advCTA\par\vspace{3pt}\upshape\bfseries\color{adGreen} Register: \advRegisterShow};

  % ---- footer -------------------------------------------------------
  \draw[adAccent,line width=2pt]
       ($(current page.south west)+(0,0.85)$) -- ($(current page.south east)+(0,0.85)$);
  \node[anchor=south, text=adSoft, font=\scriptsize] at
       ($(current page.south)+(0,0.3)$)
       {\companyName \,\textbullet\, \coWebsite \,\textbullet\, \coEmail \,\textbullet\, T~\officeHQphone \,\textbullet\, VAT~\coVAT};
\end{tikzpicture}%
}

\endinput
