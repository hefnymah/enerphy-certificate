% =====================================================================
%  enerphycert.sty  —  Enerphy certificate ENGINE (the "class").
%
%  This package encapsulates the whole certificate layout and exposes a
%  small API so data (company / course / participants) stays separate:
%
%     \usecourse{<key>}                 load courses/<key>/course.tex + content
%     \setparticipant{name}{org}{certno}  set the current holder
%     \makecertificate                  render one certificate (2 pages)
%     \batchcertificates{<csv>}         one certificate per CSV row (mass production)
%     \singlecertificate{<csv>}{certno} render just one row from the CSV
%
%  Pure LaTeX — works locally (tectonic / pdflatex / xelatex) and on
%  Overleaf.  Company data comes from src/company.tex (\input in main.tex).
% =====================================================================
\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{enerphycert}[2026/07/06 v1.0 Enerphy certificate engine]

% ---- required packages ---------------------------------------------
\RequirePackage[a4paper,margin=0pt]{geometry}
\RequirePackage{tikz}
\RequirePackage[T1]{fontenc}
\RequirePackage{helvet}                 % Helvetica-like sans
\renewcommand{\familydefault}{\sfdefault}
\RequirePackage{microtype}
\RequirePackage{graphicx}               % \resizebox + \includegraphics
\RequirePackage{eso-pic}                % per-page branded backdrop
\RequirePackage{qrcode}                 % real scannable QR
\RequirePackage{csvsimple}              % CSV-driven batch production
\RequirePackage{etoolbox}               % robust string comparison for single export
\usetikzlibrary{calc}
\pagestyle{empty}

% ---- colour palette -------------------------------------------------
\definecolor{bg}{RGB}{237,238,239}
\definecolor{band}{RGB}{225,226,228}
\definecolor{ink}{RGB}{45,48,52}
\definecolor{softink}{RGB}{95,100,106}
\definecolor{logogrey}{RGB}{176,180,184}
\definecolor{accent}{RGB}{228,118,32}
\definecolor{barword}{RGB}{196,199,203}
\definecolor{guilA}{RGB}{235,120,40}
\definecolor{guilB}{RGB}{44,96,128}
\definecolor{guilC}{RGB}{120,170,205}

% ---- single layout control: left grey-bar width (cm) ---------------
\def\barwidth{4.8}
\newlength{\coursemargin}

% ---- course page toggle (course.tex may flip this) -----------------
\newif\ifcoursepage \coursepagetrue

% =====================================================================
%  PRESENTATION HELPERS (compose display blocks from data fields)
% =====================================================================
% right-column office block: label / address(\\ lines) / phone / email
\newcommand{\officeblock}[4]{%
  \textbf{#1}\\ #2\\ \mbox{T~#3}\\ \mbox{#4}}
% full right-column info (built from the office fields in company.tex)
\newcommand{\companyInfo}{%
  \officeblock{\officeHQlabel}{\officeHQaddress}{\officeHQphone}{\officeHQemail}\\
  \mbox{Reg.\ \coRegNo}\\[10pt]
  \officeblock{\officeEGlabel}{\officeEGaddress}{\officeEGphone}{\officeEGemail}}
% top-right logo: text acronym or image, per the company.tex switch
\newcommand{\rendercoLogo}{%
  \ifcoLogoImage
    \includegraphics[height=1.7cm]{\coLogoImage}%
  \else
    {\color{logogrey}\fontsize{58}{58}\selectfont\bfseries \coLogoMark}%
  \fi}
% styled heading for the course-content page (white-space separator above)
\newcommand{\coursesection}[1]{%
  \vspace{1.4em}%
  {\color{ink}\normalsize\bfseries #1}\par
  \vspace{-0.5em}{\color{accent}\rule{2.2cm}{1.1pt}}\par
  \vspace{0.25em}}

% ---- swappable background art (files live in src/backgrounds/) ------
% A background file \renewcommand's \certbackground with its drawing.
% \pagebackdrop calls \certbackground between the bar and the logo.
% Default is empty (plain); main.tex picks one with \usebackground{...}.
\newcommand{\certbackground}{}
\newcommand{\usebackground}[1]{\input{src/backgrounds/#1.tex}}

% =====================================================================
%  SHARED PAGE BACKDROP — background, left bar, vertical wordmark,
%  full-page guilloché engraving and the top-right logo mark.
% =====================================================================
\newcommand{\pagebackdrop}[1]{%
  \fill[bg] (current page.south west) rectangle (current page.north east);
  \fill[band] (current page.south west) rectangle ($(current page.north west)+(\barwidth,0)$);
  \node[rotate=90, text=barword, anchor=center] at
       ($(current page.west)+({\barwidth/2},0)$)
       {\resizebox{\paperheight}{!}{\bfseries #1}};
  \certbackground   % swappable background art (src/backgrounds/*.tex)
  \node[anchor=north east] at ($(current page.north east)+(-1.1,-1.15)$) {\rendercoLogo};
  \draw[accent,line width=1.3pt]
        ($(current page.north east)+(-3.9,-2.15)$) -- ($(current page.north east)+(-1.1,-2.15)$);%
}

% Branded backdrop on EVERY page (works for single & batch alike).
\AddToShipoutPictureBG{%
  \begin{tikzpicture}[remember picture,overlay]\pagebackdrop{CERTIFICATE}\end{tikzpicture}%
}
% Page number, foreground, same spot on every page.  Each certificate is
% two pages, so odd shipout pages are "1 of 2", even are "2 of 2".
\AddToShipoutPictureFG{%
  \begin{tikzpicture}[remember picture,overlay]
    \node[anchor=south east, text=softink, font=\scriptsize]
         at ($(current page.south east)+(-1.0,0.9)$)
         {\ifcoursepage Page \ifodd\value{page}1\else2\fi\ of 2\else Page 1 of 1\fi};
  \end{tikzpicture}%
}

% =====================================================================
%  DATA API
% =====================================================================
% \usecourse{<dir>} : load a certificate folder. <dir> is a project-root
% relative path holding course.tex, content.tex and participants.csv
% (e.g. courses/fssc-22000-awareness or carbon-offsets/saf-flight-offset).
\newcommand{\coursedir}{}
\newcommand{\usecourse}[1]{%
  \def\coursedir{#1}%
  \input{\coursedir/course.tex}%
  \def\courseContentFile{\coursedir/content}%
}
% \setparticipant{name}{organisation}{certno} : the current holder
\newcommand{\setparticipant}[3]{%
  \def\recipient{#1}\def\recipientAddr{#2}\def\certNo{#3}}

% =====================================================================
%  RENDER ONE CERTIFICATE (page 1 + optional course page)
% =====================================================================
\newcommand{\makecertificate}{%
  % ================= PAGE 1 =================
  \begin{tikzpicture}[remember picture,overlay]
    % (backdrop + page number come from the shipout hooks)
    % ---- company info block (right column, below the logo) ----
    \node[anchor=north west, text width=3.8cm, align=left] at
         ($(current page.north east)+(-4.4,-3.25)$)
    {%
      \hyphenpenalty=10000\exhyphenpenalty=10000\relax
      {\color{ink}\footnotesize\bfseries \companyName\par}
      \vspace{10pt}
      {\color{softink}\scriptsize \baselineskip=13pt \companyInfo\par}
    };
    % ---- certification logos stacked down the right column ----
    \node[anchor=center, inner sep=0] at ($(current page.north east)+(-3.0,-11.1)$)
         {\includegraphics[width=2.7cm]{\isoLogoA}};
    \node[anchor=center, inner sep=0] at ($(current page.north east)+(-3.0,-13.9)$)
         {\includegraphics[width=2.7cm]{\isoLogoB}};
    \node[anchor=center, inner sep=0] at ($(current page.north east)+(-3.0,-16.4)$)
         {\includegraphics[width=3.1cm]{\isoLogoC}};
    % ---- main text column ----
    \pgfmathsetlengthmacro{\certtextwidth}{(16.1-\barwidth)*1cm}%
    \node[anchor=north west, text width=\certtextwidth, align=left] at
         ($(current page.north west)+({\barwidth+0.4},-2.55)$)
    {%
      \hyphenpenalty=10000\exhyphenpenalty=10000\relax
      \color{softink}\footnotesize Certificate \certNo\par
      \vspace{1.1em}
      \color{softink}\footnotesize \preLine\par
      \vspace{0.5em}
      {\color{ink}\fontsize{20}{24}\selectfont\bfseries \recipient\par}
      \vspace{0.55em}
      {\color{ink}\small \recipientAddr\par}
      \vspace{0.5em}
      \color{softink}\footnotesize \assessLine\par
      \vspace{0.9em}
      {\color{ink}\fontsize{18}{22}\selectfont\bfseries \courseTitle\par}
      \vspace{0.9em}
      {\color{softink}\footnotesize \schemeLine\par}
      \vspace{1.4em}
      \color{softink}\footnotesize \scopeCaption\par
      \vspace{0.7em}
      {\color{ink}\small\bfseries \scopeText\par}
      \vspace{0.9em}
      {\color{ink}\small\bfseries \categoryText\par}
      \vspace{1.6em}
      {\color{ink}\small \validBlock\par}
    };
    % ---- signature block & official stamp ----
    \node[anchor=north east, text width=8cm, align=right, text=softink, font=\footnotesize]
         at ($(current page.north west)+(15.3,-16.2)$) {\signRole};
    \node[anchor=center, inner sep=0] at ($(current page.north west)+(13.3,-17.6)$)
         {\includegraphics[height=2.0cm]{\signImage}};
    \draw[softink,line width=0.4pt]
         ($(current page.north west)+(11.2,-18.75)$) -- ($(current page.north west)+(15.3,-18.75)$);
    \node[anchor=north east, text width=8cm, align=right, text=softink, font=\footnotesize]
         at ($(current page.north west)+(15.3,-18.95)$) {\signName};
    \node[anchor=north east, text width=9cm, align=right, text=softink, font=\scriptsize]
         at ($(current page.north west)+(15.3,-19.65)$) {\issuerBlock};
    \node[anchor=center, inner sep=0, opacity=0.9, rotate=-8]
         at ($(current page.north west)+(10.0,-17.3)$)
         {\includegraphics[width=3.1cm]{\stampImage}};
    % ---- verification container + QR + fine print ----
    \pgfmathsetmacro{\stripL}{\barwidth+0.4}
    \def\stripR{19.8}
    \draw[softink,line width=0.3pt,opacity=0.6]
      ($(current page.south west)+(\stripL,1.55)$) rectangle ($(current page.south west)+(\stripR,4.15)$);
    \node[anchor=south west, inner sep=0] at ($(current page.south west)+(\stripL+0.35,1.98)$)
         {\qrcode[height=1.95cm,level=M]{\verifyQR}};
    \node[anchor=west, align=left, text=ink] at ($(current page.south west)+(\stripL+2.85,3.35)$)
         {\footnotesize\bfseries \verifyHead};
    \node[anchor=west, align=left, text=softink] at ($(current page.south west)+(\stripL+2.85,2.90)$)
         {\scriptsize \verifyLine};
    \node[anchor=west, align=left, text=softink] at ($(current page.south west)+(\stripL+2.85,2.45)$)
         {\scriptsize Certificate No.\ \textbf{\certNo}};
    \node[anchor=south west, text width=14cm, align=left, text=softink, font=\scriptsize]
         at ($(current page.south west)+(\stripL,4.85)$)
         {\rule{6cm}{0.3pt}\\[4pt]\finePrint};
  \end{tikzpicture}%
  % ================= PAGE 2 (course content) =================
  \ifcoursepage
    \clearpage
    \setlength{\coursemargin}{\barwidth cm}\addtolength{\coursemargin}{1.2cm}
    \newgeometry{left=\coursemargin, right=1.7cm, top=2.9cm, bottom=1.6cm}
    \setlength{\parindent}{0pt}\setlength{\parskip}{2.5pt}
    \noindent
    {\color{softink}\footnotesize Annex to Certificate No.~\certNo\par}
    {\color{softink}\footnotesize Issued to \recipient\par}
    \vspace{1pt}
    {\color{ink}\fontsize{19}{22}\selectfont\bfseries \coursePageTitle\par}
    \vspace{1pt}{\color{accent}\rule{2.6cm}{1.6pt}}\par
    \vspace{1pt}
    {\color{softink}\normalsize \courseTitle\par}
    \vspace{4pt}
    \color{ink}\small
    \input{\courseContentFile}%
  \fi
  \clearpage
}

% =====================================================================
%  MASS PRODUCTION  &  SINGLE EXPORT  (pure LaTeX, Overleaf-friendly)
% =====================================================================
% One certificate per row of the CSV (header: certno,name,org).
\newcommand{\batchcertificates}[1]{%
  \csvreader{#1}{certno=\ccertno,name=\cname,org=\corg}{%
    \setparticipant{\cname}{\corg}{\ccertno}\makecertificate}%
}
% Just the row whose certificate number matches #2.
\newcommand{\singlecertificate}[2]{%
  \def\targetcertno{#2}%
  \csvreader{#1}{certno=\ccertno,name=\cname,org=\corg}{%
    \ifdefstrequal{\ccertno}{\targetcertno}%
      {\setparticipant{\cname}{\corg}{\ccertno}\makecertificate}{}%
  }%
}

\endinput
